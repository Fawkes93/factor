# Factor — copy to .env for local runs. On Render, set secrets in the dashboard.
#
# Product / risk defaults (kinds, symbols, SL/TP, open limits, poll) live in
# factor/config.py — not here. Env only overrides when you need a one-off.

HOST=127.0.0.1
PORT=8090

# Safety switches
TRADING_ENABLED=false
CTRADER_DRY_RUN=true
CTRADER_HOST=demo
BROKER=ctrader

# Secrets — never commit real values
WEBHOOK_SECRET=whsec_change_me_long_random
FACTOR_ADMIN_TOKEN=admin_change_me_long_random
# Bot username without @. The AI trader card uses it for the Telegram link.
TELEGRAM_BOT_USERNAME=

REAKTOR_BASE_URL=https://YOUR-REAKTOR.onrender.com
REAKTOR_API_KEY=rk_change_me

# Supabase multi-user
SUPABASE_URL=https://ewaloiemhjuuwlshzsmy.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
FACTOR_TOKEN_ENC_KEY=
FACTOR_SESSION_SECRET=
MULTI_USER=false

# cTrader Open API app (OAuth) — https://openapi.ctrader.com/
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_REDIRECT_URI=http://127.0.0.1:8090/auth/ctrader/callback
# Legacy single-tenant (unused when MULTI_USER=true)
CTRADER_ACCESS_TOKEN=
CTRADER_ACCOUNT_ID=

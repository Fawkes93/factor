# Factor — copy to .env for local runs. On Render, set secrets in the dashboard.
#
# Product / risk defaults (kinds, symbols, SL/TP, open limits, poll) live in
# factor/config.py — not here. Env only overrides when you need a one-off.

HOST=127.0.0.1
PORT=8090

# Safety switches
TRADING_ENABLED=false
CTRADER_DRY_RUN=true
CTRADER_HOST=demo
BROKER=ctrader

# Secrets — never commit real values
WEBHOOK_SECRET=whsec_change_me_long_random
FACTOR_ADMIN_TOKEN=admin_change_me_long_random

REAKTOR_BASE_URL=https://YOUR-REAKTOR.onrender.com
REAKTOR_API_KEY=rk_change_me

# cTrader Open API — https://openapi.ctrader.com/  · docs/CTRADER.md
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCESS_TOKEN=
CTRADER_ACCOUNT_ID=

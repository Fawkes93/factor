# Factor — copy to .env for local runs. On Render, set these in the dashboard.

HOST=127.0.0.1
PORT=8090

# Safety
TRADING_ENABLED=false
BROKER=ctrader

# Reaktor webhook
WEBHOOK_SECRET=whsec_change_me_long_random
FACTOR_ADMIN_TOKEN=admin_change_me_long_random

# Reaktor pull backup
REAKTOR_BASE_URL=https://YOUR-REAKTOR.onrender.com
REAKTOR_API_KEY=rk_change_me
CATCHUP_ON_START=true
POLL_INTERVAL_SEC=60

TRADE_KINDS=candle
TRADE_SYMBOLS=XAU/USD
MAX_OPEN_PER_SYMBOL=1
MAX_TRADES_PER_DAY=10
COOLDOWN_SEC=300

# cTrader Open API — IC Markets demo
# https://openapi.ctrader.com/  + docs/CTRADER.md
CTRADER_HOST=demo
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCESS_TOKEN=
CTRADER_ACCOUNT_ID=
# true = compute/log order only, do not send
CTRADER_DRY_RUN=true

# Factor — copy to .env for local runs. On Render, set these in the dashboard.

# Server (Render injects PORT and expects 0.0.0.0)
HOST=127.0.0.1
PORT=8090

# Safety — keep trading off until paper path is proven
TRADING_ENABLED=false
BROKER=paper

# Shared with Reaktor REAKTOR_WEBHOOKS[].secret
WEBHOOK_SECRET=whsec_change_me_long_random

# Protects /api/trades, /api/kill, /api/catchup on a public URL
FACTOR_ADMIN_TOKEN=admin_change_me_long_random

# Catch-up + backup poll (Factor → Reaktor pull API)
REAKTOR_BASE_URL=https://YOUR-REAKTOR.onrender.com
REAKTOR_API_KEY=rk_change_me
CATCHUP_ON_START=true
POLL_INTERVAL_SEC=60

# What to trade
TRADE_KINDS=candle
TRADE_SYMBOLS=XAU/USD

# Limits
MAX_OPEN_PER_SYMBOL=1
MAX_TRADES_PER_DAY=10
COOLDOWN_SEC=300
